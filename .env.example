# Entorno de ejecución: development | production
FLASK_ENV=production

# Clave secreta de Flask (usar un valor único y privado en cada entorno)
SECRET_KEY=cambia-esta-clave-por-una-segura

# Base de datos MySQL
DB_USER=ecommerce_user
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=localhost
DB_NAME=ecommerce_db

# Servidor Gunicorn
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=3
